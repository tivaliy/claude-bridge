# =============================================================================
# Claude Bridge Configuration
# =============================================================================

# Application Settings
DEBUG=false
# Loopback by default; the bridge has no auth of its own.
HOST=127.0.0.1
PORT=8000

# Logging
LOG_LEVEL=info

# =============================================================================
# Authentication
# =============================================================================

# The `claude` CLI authenticates, not the bridge. Set ANTHROPIC_API_KEY in the
# process environment — `export ANTHROPIC_API_KEY=sk-ant-...` — NOT in this file:
# it is not a bridge setting, and putting it here fails startup validation.
#
# Without it the CLI falls back to a Pro/Max subscription token, which Anthropic's
# terms reserve for interactive use of Claude Code. See README → Authentication.
# The bridge logs a warning at startup when no key is present.

# =============================================================================
# Claude CLI Settings
# =============================================================================

# Path to claude CLI binary (default: "claude")
CLAUDE_CLI_PATH=claude

# Optional: Set working directory for Claude Code operations
# CLAUDE_CWD=/path/to/your/project

# =============================================================================
# Claude CLI Permissions (REQUIRED for File Upload)
# =============================================================================

# IMPORTANT: File upload is DISABLED by default for security.
# You must explicitly configure the settings below to enable file access.

# Allowed Tools (comma-separated)
# Set to "Read" to enable file upload
# Leave empty to disable file upload entirely
# SECURITY: Only enable tools you trust!
#
# Examples:
#   CLAUDE_ALLOWED_TOOLS_STR=Read                    # Only read files (recommended)
#   CLAUDE_ALLOWED_TOOLS_STR=Read,Bash               # Read + execute (dangerous!)
#   CLAUDE_ALLOWED_TOOLS_STR=                        # Disabled (secure default)
#
CLAUDE_ALLOWED_TOOLS_STR=

# Tool availability is gated by --tools, which the bridge sets to "" unless file
# upload is configured — see CLAUDE_ALLOWED_TOOLS_STR above. That is what keeps a
# caller away from your files: bypassPermissions applies no path restriction to
# Read/Glob/Grep, so the protection is that they do not exist.
#
# Disallowed Tools (comma-separated) — defense-in-depth beneath --tools.
# Under bypassPermissions, CLAUDE_ALLOWED_TOOLS_STR only pre-approves the tools you
# name; it does not withhold the rest. Only this setting withholds anything.
#
# LEAVE IT UNSET. The default (DEFAULT_DISALLOWED_TOOLS in config.py) withholds
# every tool that executes, mutates, delegates, outlives the request, or reaches
# the network, and leaves Read/Glob/Grep for the file-upload path.
#
# Deliberately not shown here as an example to uncomment: setting this REPLACES
# the default instead of adding to it, so any short list silently drops the ~30
# other protections, and an empty value lifts the boundary entirely. To override,
# copy the full list out of config.py and edit that.

# Load no MCP servers (default true). When false, the CLI inherits the operator's
# personal MCP configuration and an HTTP caller can reach whatever it exposes.
# CLAUDE_STRICT_MCP_CONFIG=true

# Allowed Directories (comma-separated absolute paths)
# Specify which directories Claude can access
# Leave empty to disable file access
# SECURITY: Only allow directories you control!
#
# Examples:
#   CLAUDE_ALLOWED_DIRECTORIES_STR=/tmp              # Unix/Linux/macOS
#   CLAUDE_ALLOWED_DIRECTORIES_STR=C:\Temp           # Windows
#   CLAUDE_ALLOWED_DIRECTORIES_STR=/tmp,/var/temp    # Multiple directories
#   CLAUDE_ALLOWED_DIRECTORIES_STR=                  # Disabled (secure default)
#
CLAUDE_ALLOWED_DIRECTORIES_STR=

# Permission Mode
# - bypassPermissions: Skip permission prompts (required for API mode)
# - default: Interactive mode (will fail in API context)
# - acceptEdits: Auto-accept edit operations
#
# NOTE: informational only — not read by the bridge, which always passes
# bypassPermissions (an HTTP caller cannot answer a permission prompt).
CLAUDE_PERMISSION_MODE=bypassPermissions

# =============================================================================
# Quick Start for File Upload
# =============================================================================
#
# To enable file upload support:
#
# 1. Set these two settings (or use CLI args):
#    CLAUDE_ALLOWED_TOOLS_STR=Read
#    CLAUDE_ALLOWED_DIRECTORIES_STR=/tmp
#
# 2. Restart the server:
#    claude-bridge
#
#    Or use CLI arguments:
#    claude-bridge --allowed-tools Read --allowed-directories /tmp
#
# =============================================================================

# =============================================================================
# Claude CLI Timeouts
# =============================================================================

# Maximum time (seconds) for non-streaming requests
CLAUDE_PROCESS_TIMEOUT_SECONDS=300

# Maximum idle time (seconds) during streaming
CLAUDE_STREAM_IDLE_TIMEOUT_SECONDS=180

# Grace period (seconds) after sending kill signal
CLAUDE_PROCESS_KILL_GRACE_SECONDS=5

# Comma-separated CORS origins. Empty (default) means no cross-origin access.
# CORS_ALLOW_ORIGINS_STR=
